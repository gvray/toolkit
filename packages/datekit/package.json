{
  "name": "@gvray/datekit",
  "version": "1.0.1",
  "description": "Date and time utilities: formatting, duration, timezone, comparison, and validation.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "esm/index.js",
  "exports": {
    "import": "./esm/index.js",
    "require": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "files": [
    "lib",
    "esm",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.json --module esnext --outDir esm",
    "clean": "rimraf lib esm",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "tsc -p tsconfig.json --module esnext --outDir esm --watch"
  },
  "keywords": [
    "date",
    "time",
    "datetime",
    "format",
    "parse",
    "timezone",
    "calendar",
    "duration",
    "typescript",
    "javascript"
  ],
  "author": {
    "name": "GavinRay",
    "email": "gavinraydev@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gavinray/toolkit.git",
    "directory": "packages/datekit"
  },
  "publishConfig": {
    "access": "public"
  }
}
