{
  "name": "@gvray/validationkit",
  "version": "1.0.1",
  "description": "Data and form validation utilities: type validators, schema validation, async validation, and form helpers.",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "esm",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.json --module esnext --outDir esm",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "tsc -p tsconfig.json --module esnext --outDir esm --watch"
  },
  "keywords": [
    "validation",
    "validator",
    "schema",
    "form",
    "data",
    "typescript",
    "javascript"
  ],
  "author": {
    "name": "GavinRay",
    "email": "gavinraydev@gmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
