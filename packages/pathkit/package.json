{
  "name": "@gvray/pathkit",
  "version": "1.2.2",
  "description": "Path manipulation utilities: URL parsing, query string handling, path normalization, and joining.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "swiftlet build",
    "clean": "rimraf dist",
    "dev": "swiftlet dev",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "path",
    "url",
    "query-string",
    "normalize",
    "join",
    "parse",
    "filepath",
    "utility",
    "typescript",
    "javascript"
  ],
  "author": {
    "name": "GavinRay",
    "email": "gvray87@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gvray/toolkit/issues"
  },
  "homepage": "https://github.com/gvray/toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvray/toolkit.git"
  },
  "dependencies": {
    "@gvray/eskit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
