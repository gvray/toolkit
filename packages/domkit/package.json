{
  "name": "@gvray/domkit",
  "version": "1.2.0",
  "description": "DOM manipulation utilities: events, class toggling, bounds, scroll, fullscreen, download, clipboard, and more.",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "swiftlet build",
    "clean": "rimraf dist",
    "dev": "swiftlet dev",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "dom",
    "browser",
    "jsdom",
    "events",
    "class",
    "scroll",
    "fullscreen",
    "clipboard",
    "utility",
    "typescript",
    "javascript"
  ],
  "author": {
    "name": "GavinRay",
    "email": "gvray87@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gvray/toolkit/issues"
  },
  "homepage": "https://github.com/gvray/toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvray/toolkit.git"
  },
  "dependencies": {
    "@gvray/eskit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
