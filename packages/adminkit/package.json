{
  "name": "@gvray/adminkit",
  "version": "1.1.0",
  "description": "Admin-focused utilities for building backend management systems.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "esm/index.js",
  "exports": {
    "import": "./esm/index.js",
    "require": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "files": [
    "esm",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:esm": "tsc -p tsconfig.json --target ES5 --module ESNext --outDir esm",
    "build:cjs": "tsc -p tsconfig.json --target ES5 --module commonjs --outDir lib",
    "clean": "rimraf lib esm",
    "tsc": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "dev": "tsc -p tsconfig.json --target ES5 --module ESNext --outDir esm --watch"
  },
  "keywords": [
    "path",
    "domkit",
    "jsdom",
    "util",
    "path-util",
    "toolkit",
    "tool"
  ],
  "author": {
    "name": "GavinRay",
    "email": "gavinraydev@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gvray/toolkit/issues"
  },
  "homepage": "https://github.com/gvray/toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvray/toolkit.git"
  },
  "dependencies": {
    "@gvray/eskit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
