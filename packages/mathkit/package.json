{
  "name": "@gvray/mathkit",
  "version": "1.0.1",
  "description": "Mathematical utilities: arithmetic precision, statistics, geometry, random number generation, and number checks.",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    "import": "./esm/index.js",
    "require": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "files": [
    "lib",
    "esm",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.json --module esnext --outDir esm",
    "clean": "rimraf lib esm",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "tsc -p tsconfig.json --module esnext --outDir esm --watch"
  },
  "keywords": [
    "math",
    "mathematics",
    "calculation",
    "numbers",
    "statistics",
    "arithmetic",
    "typescript",
    "javascript"
  ],
  "author": {
    "name": "GavinRay",
    "email": "gavinraydev@gmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
